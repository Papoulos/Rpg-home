# RPg-home Configuration
# Copy this file to .env and fill in your values
# This file is ignored by Git

# ============================================
# API Keys for Chatbot Services
# ============================================
# Uncomment and set the keys for the services you want to use

# Google Gemini API Key
# APIKEY_GEMINI=your_gemini_api_key_here

# Mistral AI API Key
# APIKEY_MISTRAL=your_mistral_api_key_here

# Custom OpenAI-compatible API
# CUSTOMBOT_URL=https://your-api-endpoint.com/v1/chat/completions
# CUSTOMBOT_KEY=your_api_key_here

# Custom API Endpoint (for #ask command)
# CUSTOM_API_ENDPOINT=https://your-custom-api.com/chat

# ============================================
# Server Configuration
# ============================================
# Port (default: 3000)
# PORT=3000

# ============================================
# Docker Proxy Configuration (Nginx + Let's Encrypt + DynDNS)
# ============================================
# Your domain name
# DOMAIN=jdr.votre-domaine.fr

# Your email address (for Let's Encrypt / Certbot)
# EMAIL=votre-email@gmail.com

# DynDNS Configuration (Example for OVH DynHost)
# Leave empty if you don't use DynDNS
# DYNHOST_USER=votre-domaine.fr-jdr
# DYNHOST_PASS=le-mot-de-passe-dynhost

# ============================================
# Notes:
# - All API keys are optional. Without them, chatbot features will be disabled.
# - The server will automatically load keys from this file, or from apikeys.js
# - For production, use environment variables or a secret manager
# - Never commit this file to version control
